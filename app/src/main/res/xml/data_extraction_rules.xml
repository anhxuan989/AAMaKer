<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="signing_keys" />
        <exclude domain="sharedpref" path="aamaker_bridge_auth.xml" />
    </device-transfer>
</data-extraction-rules>
